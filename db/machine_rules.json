      "resolve_intent",
      "select_template",
      "apply_identity",
      "apply_scene",
      "apply_style",
      "apply_text_layout_rules",
      "append_negative",
      "validate"
    ],
    "precedence": [
      "explicit_current_user_request",
      "explicit_template_configuration",
      "entity_hard_lock",
      "scene_specific_blocks",
      "entity_soft_traits",
      "global_machine_rules",
      "generic_defaults"
    ],
    "deprecated_templates": "exclude_by_default",
    "negative_policy": "union_and_deduplicate"
  },
  "rules": [
    {
      "id": "load_prompt_vault_first",
      "priority": 1000,
      "applies_to": [
        "all_generation",
        "all_prompt_composition"
      ],
      "level": "must",
      "instruction": "Load db/prompts.json and db/machine_rules.json before composing prompts; resolve known entities and intents before freehand generation."
    },
    {
      "id": "prefer_canonical_blocks",
      "priority": 950,
      "applies_to": [
        "all_generation"
      ],
      "level": "must",
      "instruction": "Reuse canonical blocks/templates when they cover the request; add a reusable block only for a genuinely new reusable concept."
    },
    {
      "id": "character_identity_lock",
      "priority": 930,
      "applies_to": [
        "character_generation"
      ],
      "level": "must",
      "instruction": "Inject the registered character required_blocks and preserve hard_locks unless redesign intent is explicit."
    },
    {
      "id": "text_area_plain_white",
      "priority": 900,
      "applies_to": [
        "infographic",
        "document_like_image",
        "text_heavy_image",
        "explanation_comic"
      ],
      "level": "must",
      "instruction": "Reserve body-text areas as pure solid white. Do not place paper grain, halftone, checkerboard, grid, noise, gradient, illustration, or decoration behind body text."
    },
    {
      "id": "separate_text_and_illustration",
      "priority": 890,
      "applies_to": [
        "text_heavy_image"
      ],
      "level": "must",
      "instruction": "Separate illustration and body-text zones clearly; decoration must not run behind body text."
    },
    {
      "id": "long_text_post_typeset",
      "priority": 880,
      "applies_to": [
        "text_heavy_image"
      ],
      "level": "must",
      "instruction": "When visible body text is long or accuracy-critical, generate illustration/layout first and typeset the long text deterministically afterward."
    },
    {
      "id": "regenerate_on_visual_drift",
      "priority": 860,
      "applies_to": [
        "image_editing",
        "iterative_generation"
      ],
      "level": "must",
      "instruction": "If repeated editing causes identity drift, anatomy damage, text corruption, muddy rendering, or accumulated artifacts, stop editing that image and regenerate from canonical blocks plus the latest accepted reference."
    },
    {
      "id": "avoid_excessive_gloss",
      "priority": 840,
      "applies_to": [
        "all_generation"
      ],
      "level": "default",
      "instruction": "Avoid excessive gloss, sparkle, bloom, lens flare, plastic skin, neon overload, and generic AI-anime polish unless explicitly requested."
    },
    {
      "id": "user_request_overrides_soft_defaults",
      "priority": 800,
      "applies_to": [
        "all_generation"
      ],
      "level": "must",
      "instruction": "The current explicit user request overrides soft defaults, but does not silently override registered character hard_locks."
    }
  ]
}
